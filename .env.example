# Required when running apps/server directly
CONVERSATIONS_DIR=/absolute/path/to/memoryhold-conversations

# Optional: direct Exa API key. If omitted, Memoryhold tries Exa public MCP,
# then DuckDuckGo/local fetch fallbacks for web tools.
# EXA_API_KEY=

# Optional: override Exa MCP endpoint.
# EXA_MCP_URL=https://mcp.exa.ai/mcp
