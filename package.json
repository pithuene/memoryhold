{
  "name": "memoryhold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter '!@memoryhold/electron' dev",
    "electron:dev": "pnpm --filter @memoryhold/electron dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "screenshot": "node scripts/screenshot.mjs",
    "chatgpt:login": "CHATGPT_REF_SETUP=1 node scripts/chatgpt-reference.mjs",
    "screenshot:chatgpt-ref": "node scripts/chatgpt-reference.mjs"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@types/node": "^22.15.3",
    "playwright": "^1.59.1",
    "typescript": "^5.8.3"
  }
}
