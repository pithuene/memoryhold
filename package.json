{
  "name": "memoryhold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter '!@memoryhold/electron' dev",
    "electron:dev": "pnpm --filter @memoryhold/electron dev",
    "package:mac": "pnpm --filter @memoryhold/electron package:mac",
    "package:linux": "pnpm --filter @memoryhold/electron package:linux",
    "package:linux:deb": "pnpm --filter @memoryhold/electron package:linux:deb",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "screenshot": "node scripts/screenshot.mjs",
    "chatgpt:login": "CHATGPT_REF_SETUP=1 node scripts/chatgpt-reference.mjs",
    "screenshot:chatgpt-ref": "node scripts/chatgpt-reference.mjs",
    "mobile:build": "pnpm --filter @memoryhold/mobile build:android",
    "mobile:open": "pnpm --filter @memoryhold/mobile open:android",
    "mobile:run": "pnpm --filter @memoryhold/mobile run:android"
  },
  "packageManager": "pnpm@10.19.0",
  "devDependencies": {
    "@types/node": "^22.15.3",
    "playwright": "^1.59.1",
    "typescript": "^5.8.3"
  }
}
